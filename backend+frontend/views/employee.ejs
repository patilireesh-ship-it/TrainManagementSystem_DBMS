<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TrainBook — Employee Portal</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="header">
    <a href="/" class="logo">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="13" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/><line x1="12" y1="12" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
      TrainBook
    </a>
    <nav class="nav">
      <a href="/user">Book Tickets</a>
      <a href="/timetable">Timetable</a>
      <a href="/bookings">Live Database</a>
      <a href="/employee" class="active">Employee Portal</a>
    </nav>
  </header>

  <section class="employee-portal">
    <h1 class="portal-title">Employee Portal</h1>
    <p class="portal-subtitle">Select your role and enter your Employee ID to access your dashboard.</p>

    <div class="role-cards">
      <div class="role-card" data-role="driver" onclick="selectRole('driver')">
        <div class="role-icon">
          <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="16" rx="2"/><path d="M4 11h16"/><path d="M12 3v8"/><path d="M8 19l-3 3"/><path d="M16 19l3 3"/><circle cx="8" cy="15" r="1.5"/><circle cx="16" cy="15" r="1.5"/></svg>
        </div>
        <h3>Driver</h3>
        <p>Train Operation Dashboard</p>
        <div style="margin-top:0.75rem;font-size:0.78rem;color:var(--muted);">IDs: 1, 2, 3, 4, 9</div>
      </div>
      <div class="role-card" data-role="tc" onclick="selectRole('tc')">
        <div class="role-icon">
          <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2z"/><line x1="9" y1="9" x2="9" y2="15"/><line x1="15" y1="9" x2="15" y2="15"/></svg>
        </div>
        <h3>Ticket Collector</h3>
        <p>Passenger Verification Dashboard</p>
        <div style="margin-top:0.75rem;font-size:0.78rem;color:var(--muted);">IDs: 5, 6, 7, 8, 10</div>
      </div>
      <div class="role-card" data-role="maintenance" onclick="selectRole('maintenance')">
        <div class="role-icon">
          <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
        </div>
        <h3>Maintenance Staff</h3>
        <p>Maintenance & Inspection Dashboard</p>
        <div style="margin-top:0.75rem;font-size:0.78rem;color:var(--muted);">IDs: 11, 12</div>
      </div>
    </div>

    <div class="login-form" id="loginForm">
      <h3 id="loginTitle">Login as Driver</h3>
      <div class="form-group">
        <label>Employee ID</label>
        <input type="number" id="empId" placeholder="Enter your Employee ID" min="1">
      </div>
      <div style="margin-top:1rem;">
        <button class="btn btn-primary" style="width:100%;justify-content:center;" id="loginBtn" onclick="doLogin()">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="7.5" cy="15.5" r="5.5"/><path d="m21 2-9.6 9.6"/><path d="m15.5 7.5 3 3L22 7l-3-3"/></svg>
          Access Dashboard
        </button>
      </div>
      <div id="loginError" style="color:var(--red);font-size:0.85rem;margin-top:0.75rem;text-align:center;"></div>
    </div>
  </section>

  <div class="toast-container" id="toastContainer"></div>

  <script>
    let selectedRole = '';

    function selectRole(role) {
      selectedRole = role;
      document.querySelectorAll('.role-card').forEach(c => c.classList.remove('selected'));
      document.querySelector('.role-card[data-role="' + role + '"]').classList.add('selected');

      const names = { driver: 'Driver', tc: 'Ticket Collector', maintenance: 'Maintenance Staff' };
      document.getElementById('loginTitle').textContent = 'Login as ' + names[role];
      document.getElementById('loginForm').classList.add('visible');
      document.getElementById('empId').value = '';
      document.getElementById('loginError').textContent = '';
      document.getElementById('empId').focus();
    }

    async function doLogin() {
      const id = document.getElementById('empId').value;
      if (!id) { document.getElementById('loginError').textContent = 'Please enter Employee ID'; return; }

      // Validate via API first
      try {
        const res = await fetch('/api/employee/' + selectedRole + '/' + id);
        if (res.ok) {
          window.location.href = '/employee/' + selectedRole + '/' + id;
        } else {
          const data = await res.json();
          document.getElementById('loginError').textContent = data.error || 'Employee not found. Check your ID and role.';
        }
      } catch(e) {
        document.getElementById('loginError').textContent = 'Connection error. Try again.';
      }
    }

    // Enter key support
    document.getElementById('empId').addEventListener('keypress', e => {
      if (e.key === 'Enter') doLogin();
    });
  </script>
</body>
</html>
