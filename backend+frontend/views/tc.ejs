<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TC Dashboard — <%= employee.Name %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="dashboard">
  <!-- Header -->
  <div class="dash-header">
    <div>
      <h1>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2z"/><line x1="9" y1="9" x2="9" y2="15"/><line x1="15" y1="9" x2="15" y2="15"/></svg>
        Ticket Collector Dashboard
      </h1>
      <div class="emp-name">Welcome, <%= employee.Name %> · Badge: <%= employee.Badge_No %> · Zone: <%= employee.Assigned_Zone %></div>
    </div>
    <a href="/employee" class="btn btn-outline" style="color:white;border-color:rgba(255,255,255,0.35);">← Back to Portal</a>
  </div>

  <!-- Content -->
  <div class="dash-content">
    <!-- Profile Card -->
    <div class="profile-card">
      <div class="profile-avatar"><%= employee.Name.charAt(0) %></div>
      <h2><%= employee.Name %></h2>
      <div class="emp-id">Employee ID: <%= employee.Employee_ID %></div>
      <div class="profile-detail"><span class="label">Badge No</span><span><%= employee.Badge_No %></span></div>
      <div class="profile-detail"><span class="label">Zone</span><span><%= employee.Assigned_Zone %></span></div>
      <div class="profile-detail"><span class="label">Salary</span><span>₹<%= Number(employee.Salary).toLocaleString() %>/mo</span></div>
      <div class="profile-detail"><span class="label">Phone</span><span><%= employee.Phone_no %></span></div>
      <div class="profile-detail"><span class="label">Aadhar</span><span>XXXX-XXXX-<%= employee.Aadhar_no.slice(-4) %></span></div>

      <!-- Verification Tool -->
      <div class="verify-tool">
        <h4>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px;margin-right:4px;"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          Verify Ticket
        </h4>
        <div class="verify-input-row">
          <input type="text" id="pnrInput" placeholder="Enter Booking ID / PNR">
          <button onclick="verifyTicket()">Verify</button>
        </div>
        <div id="verifyResult" style="margin-top:0.75rem;font-size:0.85rem;"></div>
      </div>
    </div>

    <!-- Main Area -->
    <div>
      <!-- Assignment -->
      <div class="assignment-card">
        <h3>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--c-midnight)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/></svg>
          Current Assignment
        </h3>
        <div class="assignment-grid">
          <div class="assign-item">
            <div class="assign-label">Assigned Train</div>
            <div class="assign-value"><%= employee.Train_Name || 'N/A' %></div>
            <div style="font-size:0.78rem;color:var(--muted);margin-top:0.15rem;">#<%= employee.Train_No || '-' %> · <%= employee.Train_Type || '' %></div>
          </div>
          <div class="assign-item">
            <div class="assign-label">Station</div>
            <div class="assign-value"><%= employee.Station_Name || 'N/A' %></div>
            <div style="font-size:0.78rem;color:var(--muted);margin-top:0.15rem;"><%= employee.City || '' %> · Platform <%= employee.Platform_No || '-' %></div>
          </div>
          <div class="assign-item">
            <div class="assign-label">Schedule Date</div>
            <div class="assign-value"><%= employee.Running_Date ? new Date(employee.Running_Date).toLocaleDateString('en-IN', {day:'numeric',month:'short',year:'numeric'}) : 'N/A' %></div>
          </div>
          <div class="assign-item">
            <div class="assign-label">Duty Time</div>
            <div class="assign-value"><%= employee.Sched_Departure ? employee.Sched_Departure.toString().substring(0,5) : '--:--' %></div>
          </div>
        </div>
      </div>

      <!-- Passenger List -->
      <div class="assignment-card">
        <h3>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--c-midnight)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          Passengers on Train #<%= employee.Train_No || '-' %>
        </h3>
        <% if (passengers && passengers.length > 0) { %>
        <div class="table-responsive">
          <table class="passenger-table">
            <thead>
              <tr><th>Booking ID</th><th>Name</th><th>Age/Sex</th><th>Coach</th><th>Seat</th><th>Class</th><th>Status</th></tr>
            </thead>
            <tbody>
              <% passengers.forEach(p => { %>
              <tr>
                <td><strong>#<%= String(p.Booking_ID).padStart(6,'0') %></strong></td>
                <td><%= p.Passenger_Name %></td>
                <td><%= p.Age %> / <%= p.Gender.charAt(0) %></td>
                <td><%= p.Coach_No || '-' %></td>
                <td><%= p.Seat_No || '-' %></td>
                <td><span class="board-type-badge" style="background:rgba(255,255,255,0.08);color:#F1F5F9;"><%= p.Class %></span></td>
                <td><span class="status-badge status-<%= p.Status.toLowerCase() %>"><%= p.Status %></span></td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <div style="margin-top:0.75rem;font-size:0.82rem;color:var(--muted);">Total: <%= passengers.length %> passenger(s) booked</div>
        <% } else { %>
        <div style="text-align:center;padding:2rem;color:var(--muted);">No passengers booked on this train yet.</div>
        <% } %>
      </div>
    </div>

    <!-- Stats -->
    <div class="stats-strip">
      <div class="stat-card">
        <div class="stat-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <div class="stat-number"><%= passengers ? passengers.length : 0 %></div>
        <div class="stat-title">Total Passengers</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2E7D32" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        </div>
        <div class="stat-number" style="color:#2E7D32;"><%= passengers ? passengers.filter(p => p.Status === 'Confirmed').length : 0 %></div>
        <div class="stat-title">Confirmed Seats</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C94400" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div class="stat-number" style="color:#C94400;"><%= passengers ? passengers.filter(p => p.Status === 'Waiting').length : 0 %></div>
        <div class="stat-title">Waiting List</div>
      </div>
    </div>
  </div>

  <script>
    function verifyTicket() {
      const pnr = document.getElementById('pnrInput').value.trim();
      if (!pnr) return;
      const resultDiv = document.getElementById('verifyResult');

      // Check against passenger list
      const rows = document.querySelectorAll('.passenger-table tbody tr');
      let found = false;
      rows.forEach(row => {
        const bookingId = row.cells[0].textContent.replace('#','').trim();
        if (parseInt(bookingId) === parseInt(pnr)) {
          found = true;
          const name = row.cells[1].textContent;
          const status = row.cells[6].textContent.trim();
          resultDiv.innerHTML = '<div style="padding:0.5rem 0.75rem;border-radius:6px;background:#E8F5E9;color:#2E7D32;font-weight:600;">Valid Ticket — ' + name + ' (' + status + ')</div>';
        }
      });
      if (!found) {
        resultDiv.innerHTML = '<div style="padding:0.5rem 0.75rem;border-radius:6px;background:#FFEBEE;color:var(--red);font-weight:600;">Booking #' + pnr + ' not found on this train</div>';
      }
    }

    document.getElementById('pnrInput').addEventListener('keypress', e => {
      if (e.key === 'Enter') verifyTicket();
    });
  </script>
</body>
</html>
