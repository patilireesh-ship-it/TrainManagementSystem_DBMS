<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Maintenance Dashboard — <%= employee.Name %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="dashboard">
  <!-- Header -->
  <div class="dash-header">
    <div>
      <h1>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
        Maintenance Dashboard
      </h1>
      <div class="emp-name">Welcome, <%= employee.Name %> · <%= employee.Shift_Type %> Shift · <%= employee.Trade_Skill %></div>
    </div>
    <a href="/employee" class="btn btn-outline" style="color:white;border-color:rgba(255,255,255,0.35);">← Back to Portal</a>
  </div>

  <!-- Content -->
  <div class="dash-content">
    <!-- Profile Card -->
    <div class="profile-card">
      <div class="profile-avatar"><%= employee.Name.charAt(0) %></div>
      <h2><%= employee.Name %></h2>
      <div class="emp-id">Employee ID: <%= employee.Employee_ID %></div>
      <div class="profile-detail"><span class="label">Shift Type</span><span><%= employee.Shift_Type %></span></div>
      <div class="profile-detail"><span class="label">Trade Skill</span><span><%= employee.Trade_Skill %></span></div>
      <div class="profile-detail"><span class="label">Salary</span><span>₹<%= Number(employee.Salary).toLocaleString() %>/mo</span></div>
      <div class="profile-detail"><span class="label">Phone</span><span><%= employee.Phone_no %></span></div>
      <div class="profile-detail"><span class="label">Aadhar</span><span>XXXX-XXXX-<%= employee.Aadhar_no.slice(-4) %></span></div>

      <div style="margin-top:1.25rem;padding:0.4rem;border-radius:6px;background:#FFF8E1;text-align:center;">
        <span style="color:#C94400;font-weight:600;font-size:0.82rem;">● <%= employee.Shift_Type %> Shift Active</span>
      </div>
    </div>

    <!-- Main Area -->
    <div>
      <!-- Assignment -->
      <div class="assignment-card">
        <h3>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--c-midnight)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/></svg>
          Current Assignment
        </h3>
        <div class="assignment-grid">
          <div class="assign-item">
            <div class="assign-label">Assigned Train</div>
            <div class="assign-value"><%= employee.Train_Name || 'N/A' %></div>
            <div style="font-size:0.78rem;color:var(--muted);margin-top:0.15rem;">#<%= employee.Train_No || '-' %> · <%= employee.Train_Type || '' %></div>
          </div>
          <div class="assign-item">
            <div class="assign-label">Station</div>
            <div class="assign-value"><%= employee.Station_Name || 'N/A' %></div>
            <div style="font-size:0.78rem;color:var(--muted);margin-top:0.15rem;"><%= employee.City || '' %> · Platform <%= employee.Platform_No || '-' %></div>
          </div>
          <div class="assign-item">
            <div class="assign-label">Schedule Date</div>
            <div class="assign-value"><%= employee.Running_Date ? new Date(employee.Running_Date).toLocaleDateString('en-IN', {day:'numeric',month:'short',year:'numeric'}) : 'N/A' %></div>
          </div>
          <div class="assign-item">
            <div class="assign-label">Trade Skill</div>
            <div class="assign-value"><%= employee.Trade_Skill %></div>
          </div>
        </div>
      </div>

      <!-- Maintenance Checklist -->
      <div class="assignment-card">
        <h3>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--c-midnight)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
          Maintenance Checklist — <%= employee.Trade_Skill %>
        </h3>

        <div class="progress-bar-container">
          <div class="progress-bar-fill" id="progressBar" style="width:0%"></div>
        </div>
        <div class="progress-text" id="progressText">0% Complete</div>

        <div class="checklist" id="checklist">
          <% if (employee.Trade_Skill === 'Electrical') { %>
            <div class="checklist-item" onclick="toggleCheck(this)"><div class="checklist-checkbox"></div><span class="checklist-text">Inspect pantograph and contact strips</span></div>
            <div class="checklist-item" onclick="toggleCheck(this)"><div class="checklist-checkbox"></div><span class="checklist-text">Test main transformer insulation</span></div>
            <div class="checklist-item" onclick="toggleCheck(this)"><div class="checklist-checkbox"></div><span class="checklist-text">Check traction motor brushes and bearings</span></div>
            <div class="checklist-item" onclick="toggleCheck(this)"><div class="checklist-checkbox"></div><span class="checklist-text">Verify coach lighting and AC systems</span></div>
            <div class="checklist-item" onclick="toggleCheck(this)"><div class="checklist-checkbox"></div><span class="checklist-text">Test emergency lighting batteries</span></div>
            <div class="checklist-item" onclick="toggleCheck(this)"><div class="checklist-checkbox"></div><span class="checklist-text">Inspect cable insulation and connectors</span></div>
            <div class="checklist-item" onclick="toggleCheck(this)"><div class="checklist-checkbox"></div><span class="checklist-text">Check fire alarm and detection systems</span></div>
            <div class="checklist-item" onclick="toggleCheck(this)"><div class="checklist-checkbox"></div><span class="checklist-text">Test public address system in all coaches</span></div>
          <% } else { %>
            <div class="checklist-item" onclick="toggleCheck(this)"><div class="checklist-checkbox"></div><span class="checklist-text">Inspect brake pads and disc conditions</span></div>
            <div class="checklist-item" onclick="toggleCheck(this)"><div class="checklist-checkbox"></div><span class="checklist-text">Check wheel profile and tread wear</span></div>
            <div class="checklist-item" onclick="toggleCheck(this)"><div class="checklist-checkbox"></div><span class="checklist-text">Test suspension springs and dampers</span></div>
            <div class="checklist-item" onclick="toggleCheck(this)"><div class="checklist-checkbox"></div><span class="checklist-text">Inspect coupling mechanisms and buffers</span></div>
            <div class="checklist-item" onclick="toggleCheck(this)"><div class="checklist-checkbox"></div><span class="checklist-text">Lubricate axle bearings and journal boxes</span></div>
            <div class="checklist-item" onclick="toggleCheck(this)"><div class="checklist-checkbox"></div><span class="checklist-text">Check door mechanisms and safety locks</span></div>
            <div class="checklist-item" onclick="toggleCheck(this)"><div class="checklist-checkbox"></div><span class="checklist-text">Inspect bogie frame for cracks and corrosion</span></div>
            <div class="checklist-item" onclick="toggleCheck(this)"><div class="checklist-checkbox"></div><span class="checklist-text">Test pneumatic brake pipeline pressure</span></div>
          <% } %>
        </div>
      </div>

      <!-- Shift Schedule -->
      <div class="assignment-card">
        <h3>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--c-midnight)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          Weekly Shift Schedule
        </h3>
        <div class="shift-grid">
          <% const days = ['Mon','Tue','Wed','Thu','Fri','Sat','Sun']; %>
          <% const shiftType = employee.Shift_Type; %>
          <% days.forEach((day, i) => { %>
            <%
              let onDuty, shiftLabel;
              if (shiftType === 'Night') {
                onDuty = i < 5;
                shiftLabel = onDuty ? '22:00–06:00' : 'OFF';
              } else {
                onDuty = (i % 2 === 0);
                shiftLabel = onDuty ? '06:00–14:00' : (i === 6 ? 'OFF' : '14:00–22:00');
              }
            %>
            <div class="shift-day <%= onDuty ? 'on-duty' : 'off-duty' %>">
              <div class="day-name"><%= day %></div>
              <div class="shift-type"><%= shiftLabel %></div>
            </div>
          <% }); %>
        </div>
      </div>
    </div>

    <!-- Stats -->
    <div class="stats-strip">
      <div class="stat-card">
        <div class="stat-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
        </div>
        <div class="stat-number">23</div>
        <div class="stat-title">Tasks Completed</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="16" rx="2"/><path d="M4 11h16"/><path d="M12 3v8"/><path d="M8 19l-3 3"/><path d="M16 19l3 3"/><circle cx="8" cy="15" r="1"/><circle cx="16" cy="15" r="1"/></svg>
        </div>
        <div class="stat-number"><%= employee.Train_No || '-' %></div>
        <div class="stat-title">Assigned Train</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div class="stat-number"><%= employee.Shift_Type %></div>
        <div class="stat-title">Current Shift</div>
      </div>
    </div>
  </div>

  <script>
    function toggleCheck(el) {
      el.classList.toggle('checked');
      updateProgress();
    }

    function updateProgress() {
      const total = document.querySelectorAll('.checklist-item').length;
      const done = document.querySelectorAll('.checklist-item.checked').length;
      const pct = Math.round((done / total) * 100);
      document.getElementById('progressBar').style.width = pct + '%';
      document.getElementById('progressText').textContent = pct + '% Complete (' + done + '/' + total + ')';
    }
  </script>
</body>
</html>
