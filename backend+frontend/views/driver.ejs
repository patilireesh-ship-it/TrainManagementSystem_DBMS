<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Driver Dashboard — <%= employee.Name %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="dashboard">
  <!-- Header -->
  <div class="dash-header">
    <div>
      <h1>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="16" rx="2"/><path d="M4 11h16"/><path d="M12 3v8"/><path d="M8 19l-3 3"/><path d="M16 19l3 3"/><circle cx="8" cy="15" r="1.5"/><circle cx="16" cy="15" r="1.5"/></svg>
        Driver Dashboard
      </h1>
      <div class="emp-name">Welcome, <%= employee.Name %></div>
    </div>
    <a href="/employee" class="btn btn-outline" style="color:white;border-color:rgba(255,255,255,0.35);">← Back to Portal</a>
  </div>

  <!-- Content -->
  <div class="dash-content">
    <!-- Profile Card -->
    <div class="profile-card">
      <div class="profile-avatar"><%= employee.Name.charAt(0) %></div>
      <h2><%= employee.Name %></h2>
      <div class="emp-id">Employee ID: <%= employee.Employee_ID %></div>
      <div class="profile-detail"><span class="label">License No</span><span><%= employee.License_No %></span></div>
      <div class="profile-detail"><span class="label">Salary</span><span>₹<%= Number(employee.Salary).toLocaleString() %>/mo</span></div>
      <div class="profile-detail"><span class="label">Phone</span><span><%= employee.Phone_no %></span></div>
      <div class="profile-detail"><span class="label">Aadhar</span><span>XXXX-XXXX-<%= employee.Aadhar_no.slice(-4) %></span></div>
      <div style="margin-top:1.25rem;padding:0.4rem;border-radius:6px;background:#E8F5E9;text-align:center;">
        <span style="color:#2E7D32;font-weight:600;font-size:0.82rem;">● Active Duty</span>
      </div>
    </div>

    <!-- Assignment -->
    <div>
      <div class="assignment-card">
        <h3>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--c-midnight)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/></svg>
          Current Assignment
        </h3>
        <div class="assignment-grid">
          <div class="assign-item">
            <div class="assign-label">Assigned Train</div>
            <div class="assign-value"><%= employee.Train_Name || 'N/A' %></div>
            <div style="font-size:0.78rem;color:var(--muted);margin-top:0.15rem;">#<%= employee.Train_No || '-' %> · <%= employee.Train_Type || '' %></div>
          </div>
          <div class="assign-item">
            <div class="assign-label">Station</div>
            <div class="assign-value"><%= employee.Station_Name || 'N/A' %></div>
            <div style="font-size:0.78rem;color:var(--muted);margin-top:0.15rem;"><%= employee.City || '' %></div>
          </div>
          <div class="assign-item">
            <div class="assign-label">Platform</div>
            <div class="assign-value">Platform <%= employee.Platform_No || '-' %></div>
          </div>
          <div class="assign-item">
            <div class="assign-label">Schedule</div>
            <div class="assign-value"><%= employee.Running_Date ? new Date(employee.Running_Date).toLocaleDateString('en-IN', {day:'numeric',month:'short',year:'numeric'}) : 'N/A' %></div>
            <div style="font-size:0.78rem;color:var(--muted);margin-top:0.15rem;">
              Dep: <%= employee.Sched_Departure ? employee.Sched_Departure.toString().substring(0,5) : '--:--' %>
            </div>
          </div>
        </div>

        <!-- Route Map -->
        <% if (stops && stops.length > 0) { %>
        <div class="route-map">
          <h4>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--c-midnight)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px;margin-right:4px;"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/><line x1="8" y1="2" x2="8" y2="18"/><line x1="16" y1="6" x2="16" y2="22"/></svg>
            Route Map — <%= employee.Train_Name %>
          </h4>
          <% stops.forEach((stop, i) => { %>
          <div class="route-stop-item">
            <div class="route-marker">
              <div class="route-marker-dot" style="<%= stop.Station_Name === employee.Station_Name ? 'background:var(--c-midnight);border-color:var(--c-midnight);' : '' %>"></div>
              <% if (i < stops.length - 1) { %><div class="route-marker-line"></div><% } %>
            </div>
            <div class="route-stop-info">
              <div class="stop-name" style="<%= stop.Station_Name === employee.Station_Name ? 'color:var(--c-midnight);font-weight:700;' : '' %>">
                <%= stop.Station_Name %> (<%= stop.City %>)
                <% if (stop.Station_Name === employee.Station_Name) { %> ← Current Location<% } %>
              </div>
              <div class="stop-time">
                <% if (stop.Arrival_Time) { %>Arr: <%= stop.Arrival_Time.toString().substring(0,5) %><% } %>
                <% if (stop.Arrival_Time && stop.Departure_Time) { %> · <% } %>
                <% if (stop.Departure_Time) { %>Dep: <%= stop.Departure_Time.toString().substring(0,5) %><% } %>
                <% if (!stop.Arrival_Time && !stop.Departure_Time) { %>--<% } %>
              </div>
            </div>
          </div>
          <% }); %>
        </div>
        <% } %>
      </div>
    </div>

    <!-- Stats -->
    <div class="stats-strip">
      <div class="stat-card">
        <div class="stat-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div class="stat-number">8h</div>
        <div class="stat-title">Duty Hours Today</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="16" rx="2"/><path d="M4 11h16"/><path d="M12 3v8"/><path d="M8 19l-3 3"/><path d="M16 19l3 3"/><circle cx="8" cy="15" r="1"/><circle cx="16" cy="15" r="1"/></svg>
        </div>
        <div class="stat-number">147</div>
        <div class="stat-title">Total Trips Completed</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        </div>
        <div class="stat-number"><%= employee.Running_Date ? new Date(employee.Running_Date).toLocaleDateString('en-IN', {day:'numeric',month:'short'}) : '-' %></div>
        <div class="stat-title">Next Scheduled Duty</div>
      </div>
    </div>
  </div>
</body>
</html>
